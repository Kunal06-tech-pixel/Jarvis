generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String
  timezone      String    @default("Asia/Kolkata")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tasks         Task[]
  reminders     Reminder[]
  events        Event[]
  conversations Conversation[]
  notifications Notification[]
  preferences   UserPreference?
  auditLogs     AuditLog[]

  @@index([email])
}

model UserPreference {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme                 String   @default("dark")
  notificationsEnabled  Boolean  @default(true)
  voiceEnabled          Boolean  @default(true)
  ttsEnabled            Boolean  @default(true)
  dailyBriefingTime     String?  @default("08:00")
  weekStartDay          String   @default("monday")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Task {
  id              String     @id @default(uuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  priority        Priority   @default(MEDIUM)
  status          TaskStatus @default(TODO)
  dueDate         DateTime?
  dueTime         String?
  category        String?
  tags            String[]   @default([])
  estimatedMinutes Int?
  completedAt     DateTime?
  recurrence      String?    // "daily", "weekly:mon,wed,fri", "monthly:15"
  reminderId      String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, priority])
  @@index([userId, category])
}

model Reminder {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  remindAt      DateTime
  recurrence    String?        // "daily", "weekly:mon", "monthly:1", "custom:..."
  status        ReminderStatus @default(ACTIVE)
  lastTriggered DateTime?
  nextTrigger   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId, status])
  @@index([remindAt])
  @@index([nextTrigger])
}

model Event {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  location    String?
  recurrence  String?
  status      EventStatus @default(CONFIRMED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId, startTime])
  @@index([userId, endTime])
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  messages  Message[]

  @@index([userId, updatedAt])
}

model Message {
  id              String       @id @default(uuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            MessageRole
  content         String
  toolCalls       Json?        // Stores tool call details for audit
  toolResults     Json?        // Stores tool execution results
  metadata        Json?        // Intent, entities, processing time
  createdAt       DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Notification {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?              // Reference IDs, action URLs
  read      Boolean            @default(false)
  createdAt DateTime           @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // "task.created", "reminder.triggered", "ai.tool_called"
  entity    String?  // "task", "reminder", "event"
  entityId  String?
  details   Json?    // Full action details
  timestamp DateTime @default(now())

  @@index([userId, timestamp])
  @@index([action])
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum ReminderStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum EventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum NotificationType {
  REMINDER
  DEADLINE
  OVERDUE
  EVENT
  AI_SUGGESTION
  SYSTEM
}
